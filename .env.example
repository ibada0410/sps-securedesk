# SPS SecureDesk AI - environment template. Copy to .env and fill values.
XAI_API_KEY=                # any OpenAI-compatible key: Groq gsk_..., OpenRouter sk-or-..., xAI xai-...
XAI_MODEL=llama-3.3-70b-versatile
XAI_BASE_URL=https://api.groq.com/openai/v1
JWT_SECRET_KEY=             # long random string, min 32 chars
DATABASE_URL=sqlite:///securedesk.db
HELPDESK_EMAIL=helpdesk@spsnet.com
APP_BASE_URL=http://localhost:8000
SMTP_HOST=                  # blank = dev outbox mode
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
IMAP_HOST=                  # blank = use Email Center inbound simulator
IMAP_USER=
IMAP_PASSWORD=
EMAIL_POLL_SECONDS=120
SLA_WARNING_MINUTES=120
# --- Microsoft SSO (optional; leave blank to use local auth only) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
